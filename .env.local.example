# ── Claude / Anthropic ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optionnel — modèle utilisé pour les rapports (défaut : claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ── NextAuth (optional — enables login protection) ──────────────
# NEXTAUTH_SECRET is REQUIRED in production when login is enabled.
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000
AUTH_USERNAME=admin
AUTH_PASSWORD=your-secure-password

# ── Supabase (optional — enables cloud sync) ────────────────────
# Setup: https://supabase.com → New project → SQL editor:
#   CREATE TABLE batches (
#     id TEXT PRIMARY KEY, data JSONB NOT NULL, report TEXT, tracking JSONB,
#     created_at TIMESTAMPTZ NOT NULL, updated_at TIMESTAMPTZ NOT NULL
#   );
#   -- base existante : ALTER TABLE batches ADD COLUMN IF NOT EXISTS tracking JSONB;
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
