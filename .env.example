# HydroLoop Farm Manager — modèle de configuration (AUCUN secret réel ici).
# Copier vers .env.local (développement) ou saisir dans les variables d'environnement de l'hébergeur (production).
# Toutes les valeurs ci-dessous sont des exemples factices.

# ── Comptes (OBLIGATOIRE en production, sinon l'application refuse de servir) ──────────────────
# Format : nom:secret,nom:secret — le secret est un mot de passe en clair OU un hachage généré par
#   npm run auth:hash -- "mon mot de passe"      (résultat : scrypt$<sel>$<hash>, à préférer)
AUTH_USERS=alice:remplacez-moi,bob:scrypt$sel$hash
# Compatibilité avec la V0 (compte unique) — facultatif si AUTH_USERS est défini
# AUTH_USERNAME=admin
# AUTH_PASSWORD=remplacez-moi

# Secret de signature des sessions : openssl rand -base64 32   (OBLIGATOIRE en production)
NEXTAUTH_SECRET=generez-une-valeur-aleatoire-de-32-octets
NEXTAUTH_URL=http://localhost:3000
# Durée de session en heures (défaut 336 = 14 jours)
# SESSION_MAX_AGE_HOURS=336

# Usage local SANS compte (déconseillé hors poste de travail) : autorise le service sans AUTH_USERS en production
# ALLOW_ANONYMOUS=true

# ── Analyse IA (facultatif) ─────────────────────────────────────────────────────────────────
# Sans clé : rapports locaux (mesures, calculs, règles) — l'application reste pleinement utilisable.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# Limites de coût (par instance serveur)
# AI_RATE_LIMIT_PER_10MIN=6
# AI_DAILY_LIMIT_PER_USER=40
# AI_DAILY_LIMIT_GLOBAL=400
# AI_MAX_OUTPUT_TOKENS=8000
# Ouvre l'IA payante à tous quand AUTH_USERS est vide en production (déconseillé)
# ALLOW_PUBLIC_AI=true

# ── Synchronisation cloud Supabase (facultatif — exige AUTH_USERS) ─────────────────────────────
# Voir docs/SUPABASE.md. Les variables NEXT_PUBLIC_* sont publiques (envoyées au navigateur) et figées à la compilation.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=clé-publique-anon
# Secret JWT du projet (Project Settings → API → JWT Secret). SECRET, serveur uniquement, ne jamais préfixer NEXT_PUBLIC_.
# SUPABASE_JWT_SECRET=...
